# Local Storage Analyzer V3 diagnostic trigger (see scripts/run_storage_v3_diagnostic.sh)
.storage-v3-diag

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode user-specific files
xcuserdata/
*.xcuserstate
UserInterfaceState.xcuserstate
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3

# Xcode build products and local build data
build/
DerivedData/
*.xcarchive
*.ipa
*.dSYM
*.profraw

# Swift Package Manager local state and build products
.build/
.swiftpm/

# Local workspace metadata
*.xcscmblueprint

# Script-generated artifacts (QA captures, diagnostics, icon pipeline intermediates)
scripts/output/

# Python bytecode
__pycache__/
*.py[cod]

# Local agent / build tooling (machine-specific)
.mobilebuildmcp/
skills-lock.json

# Locally installed agent skills (repository-owned skill: joeypet-macos)
.agents/skills/**
!.agents/skills/joeypet-macos/
!.agents/skills/joeypet-macos/**

# One-off analyzer reports (design notes under docs/ stay tracked when added intentionally)
docs/storage-analyzer-*-report.md
