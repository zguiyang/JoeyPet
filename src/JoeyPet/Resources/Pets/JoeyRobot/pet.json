{
  "id": "joey-robot",
  "name": "Joey Robot",
  "spriteSheet": "spritesheet.png",
  "frameWidth": 32,
  "frameHeight": 32,
  "columns": 4,
  "rows": 3,
  "defaultScale": 3,
  "fallbackAnimation": "idle",
  "animations": {
    "idle": {
      "frames": [0, 1],
      "fps": 2,
      "loop": true
    },
    "sweating": {
      "frames": [2, 3, 4],
      "fps": 4,
      "loop": true
    },
    "tired": {
      "frames": [5, 6],
      "fps": 2,
      "loop": true
    },
    "carryingTrash": {
      "frames": [7, 8, 9, 10],
      "fps": 4,
      "loop": true
    }
  }
}
